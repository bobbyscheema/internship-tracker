# Daily email alerts (Gmail requires an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional: comma-separated Greenhouse board slugs to add to the defaults.
GREENHOUSE_BOARDS=

# Used by the daily worker. Defaults to 08:00 local time.
ALERT_HOUR=8
